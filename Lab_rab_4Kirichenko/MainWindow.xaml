<Window x:Class="Lab_rab_4Kirichenko.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Главное окно" Height="350" Width="525">

    <StackPanel Background="{DynamicResource BackgroundColor}">

        <Menu>
            <MenuItem x:Name="Employee" Header="Сотрудники" Click="Employee_OnClick"/>
            <MenuItem x:Name="Role" Header="Должности" Click="Role_OnClick"/>
        </Menu>

        <StackPanel Orientation="Horizontal" Margin="10">
            <Label Content="Выбор темы:"/>
            <ComboBox Width="150"
                      ItemsSource="{Binding AvailableThemes}"
                      SelectedItem="{Binding SelectedTheme}"/>
        </StackPanel>
    </StackPanel>
</Window>