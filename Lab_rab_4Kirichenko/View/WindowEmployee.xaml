<Window x:Class="Lab_rab_4Kirichenko.View.WindowEmployee"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудники" Height="350" Width="600">

    <StackPanel Background="{DynamicResource BackgroundColor}">
        <ListView x:Name="lvEmployee" 
                  ItemsSource="{Binding ListPersonDPO}" 
                  SelectedItem="{Binding SelectedPersonDPO}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Id" Width="50" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Должность" Width="100" DisplayMemberBinding="{Binding Role}"/>
                    <GridViewColumn Header="Фамилия" Width="100" DisplayMemberBinding="{Binding LastName}"/>
                    <GridViewColumn Header="Имя" Width="100" DisplayMemberBinding="{Binding FirstName}"/>
                    <GridViewColumn Header="Дата рождения" Width="120" DisplayMemberBinding="{Binding Birthday, StringFormat=\{0:dd\.MM\.yyyy\}}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Добавить" Height="25" Margin="10,10,5,10" Command="{Binding AddPerson}"/>
            <Button Content="Редактировать" Height="25" Margin="10,10,5,10" Command="{Binding EditPerson}"/>
            <Button Content="Удалить" Height="25" Margin="10,10,5,10" Command="{Binding DeletePerson}"/>
        </StackPanel>
    </StackPanel>
</Window>