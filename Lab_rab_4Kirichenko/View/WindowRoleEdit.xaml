<Window x:Class="Lab_rab_4Kirichenko.View.WindowRoleEdit"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование должности" Height="150" Width="300"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{DynamicResource BackgroundColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" Text="Название должности:"/>

        <TextBox Grid.Row="0" Grid.Column="1" Margin="5" Text="{Binding NameRole, UpdateSourceTrigger=PropertyChanged}"/>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="Принять" Margin="5" Width="70" Click="Accept_Click"/>
            <Button Content="Отмена" Margin="5" Width="70" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>