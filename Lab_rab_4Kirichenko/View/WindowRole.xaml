<Window x:Class="Lab_rab_4Kirichenko.View.WindowRole"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Должности" Height="350" Width="350">

    <StackPanel Background="{DynamicResource BackgroundColor}">
        <Label Margin="5" HorizontalAlignment="Center">Список должностей сотрудников</Label>

        <ListView x:Name="lvRole" 
                  ItemsSource="{Binding ListRole}" 
                  SelectedItem="{Binding SelectedRole}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Код" Width="50" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Наименование должности" Width="200" DisplayMemberBinding="{Binding NameRole}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Добавить" Height="25" Margin="10,10,5,10" Command="{Binding AddRole}"/>
            <Button Content="Редактировать" Height="25" Margin="10,10,5,10" Command="{Binding EditRole}"/>
            <Button Content="Удалить" Height="25" Margin="10,10,5,10" Command="{Binding DeleteRole}"/>
        </StackPanel>
    </StackPanel>
</Window>